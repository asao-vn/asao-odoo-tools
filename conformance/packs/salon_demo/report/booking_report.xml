<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_booking_action" model="ir.actions.report">
        <field name="name">Booking</field>
        <field name="model">salon_demo.booking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">salon_demo.report_booking</field>
        <field name="report_file">salon_demo.report_booking</field>
        <field name="binding_model_id" ref="model_salon_demo_booking"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_booking">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 t-field="o.name"/>
                        <p t-field="o.start"/>
                        <p t-field="o.partner_id"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
